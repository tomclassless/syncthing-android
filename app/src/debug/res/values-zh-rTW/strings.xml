<?xml version="1.0" encoding="utf-8"?>
<!--
    Fork-local Traditional Chinese (Taiwan) overrides.

    This lives in the `debug` source set on purpose. Upstream's
    app/src/main/res/values-zh-rTW/strings.xml is generated by Weblate and gets
    rewritten wholesale on every `chore(weblate): imported translations` commit,
    so editing it directly would conflict on every upstream sync. Android merges
    buildType resources over `main`, so any name defined here wins for debug
    builds while `main` stays untouched.

    Scope:
      * translations for the 311 strings + 4 plurals that zh-rTW is missing
      * corrections to existing entries that used non-Taiwanese wording
      * second person unified as 「你」 (Android Taiwan platform convention)
-->
<resources xmlns:tools="http://schemas.android.com/tools">

